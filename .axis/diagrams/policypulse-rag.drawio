<mxfile host="axis">
  <diagram name="policypulse-rag" id="policypulse-rag">
    <mxGraphModel dx="1800" dy="1000" grid="1" gridSize="10" guides="1" arrows="1" page="1" pageWidth="1850" pageHeight="1000" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Outer panels -->
        <mxCell id="local" value="LOCAL MACHINE" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#666666;fontColor=#444444;fontStyle=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="1220" height="945" as="geometry" /></mxCell>
        <mxCell id="cloud" value="GOOGLE CLOUD: VERTEX AI" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#9673a6;fontColor=#7a4f9a;fontStyle=1;fontSize=13;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="1300" y="20" width="500" height="945" as="geometry" /></mxCell>

        <!-- Lanes -->
        <mxCell id="laneQ" value="QUERY PATH (runs on every question)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#6c8ebf;fontColor=#3a6aa5;fontStyle=1;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="1180" height="410" as="geometry" /></mxCell>
        <mxCell id="laneI" value="INGESTION PATH: python scripts/ingest_corpus.py (safe to re-run)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=none;strokeColor=#82b366;fontColor=#4f8a3c;fontStyle=1;fontSize=12;verticalAlign=top;align=left;spacingLeft=12;spacingTop=2;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="1180" height="310" as="geometry" /></mxCell>

        <!-- Query path nodes -->
        <mxCell id="user" value="&lt;b&gt;1. User&lt;/b&gt;&lt;br&gt;browser" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="120" height="90" as="geometry" /></mxCell>
        <mxCell id="runner" value="&lt;b&gt;2. adk web / Runner&lt;/b&gt;&lt;br&gt;FastAPI, localhost:8000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="190" height="90" as="geometry" /></mxCell>
        <mxCell id="sessions" value="Session store&lt;br&gt;policypulse_rag/.adk/" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="300" y="280" width="170" height="90" as="geometry" /></mxCell>
        <mxCell id="agent" value="&lt;b&gt;3. LlmAgent &quot;policypulse_rag&quot;&lt;/b&gt;&lt;br&gt;agent.py, instruction in prompts.py&lt;br&gt;answers from returned chunks only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="110" width="280" height="90" as="geometry" /></mxCell>
        <mxCell id="retr" value="&lt;b&gt;4. PolicyDocsRetrieval&lt;/b&gt;&lt;br&gt;subclass of ADK VertexAiRagRetrieval&lt;br&gt;similarity_top_k=10, vector_distance_threshold=0.6" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="640" y="280" width="280" height="100" as="geometry" /></mxCell>
        <mxCell id="note" value="&lt;b&gt;5. Answer contract:&lt;/b&gt; built from the returned chunks only, with inline citations such as [GDPR Art. 33(1)]. When the documents do not cover the question, the reply is exactly &quot;The provided reference documents do not cover this topic.&quot;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f5f9ff;strokeColor=#6c8ebf;fontColor=#1a1a1a;fontSize=11;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60" y="405" width="880" height="48" as="geometry" /></mxCell>

        <!-- Ingestion path nodes -->
        <mxCell id="docs" value="&lt;b&gt;1. docs/&lt;/b&gt; (immutable raw layer)&lt;br&gt;GDPR, HIPAA summary, NCSP 2013, Road Safety 2010 PDFs; Registration API spec (md or PDF, other system, not yet supplied)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="170" height="110" as="geometry" /></mxCell>
        <mxCell id="extract" value="&lt;b&gt;2. Extract text&lt;/b&gt;&lt;br&gt;pypdf per page; markdown read as is" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="285" y="550" width="170" height="110" as="geometry" /></mxCell>
        <mxCell id="split" value="&lt;b&gt;3. Per-document splitter&lt;/b&gt;&lt;br&gt;citation blocks: label, breadcrumb, text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="510" y="550" width="170" height="110" as="geometry" /></mxCell>
        <mxCell id="render" value="&lt;b&gt;4. Render&lt;/b&gt;&lt;br&gt;build/corpus/&amp;lt;doc_id&amp;gt;.md with breadcrumb heading, Cite as: line and End of line per block" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="735" y="550" width="170" height="110" as="geometry" /></mxCell>
        <mxCell id="gate" value="&lt;b&gt;5. Contract gate&lt;/b&gt;&lt;br&gt;required labels present, block counts in range; a failure stops the run before any cloud call" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="735" y="700" width="170" height="100" as="geometry" /></mxCell>
        <mxCell id="sync" value="&lt;b&gt;6. Corpus sync&lt;/b&gt;&lt;br&gt;find or create corpus; upload changed files (&amp;lt;doc_id&amp;gt;__&amp;lt;sha12&amp;gt;.md, unchanged skipped); wait for ACTIVE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;fontSize=10;" vertex="1" parent="1"><mxGeometry x="980" y="700" width="230" height="100" as="geometry" /></mxCell>
        <mxCell id="env" value="&lt;b&gt;7. .env (repo root)&lt;/b&gt;&lt;br&gt;RAG_CORPUS_RESOURCE_NAME, read by the agent at startup" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="980" y="550" width="230" height="110" as="geometry" /></mxCell>

        <!-- Evaluation side box -->
        <mxCell id="eval" value="&lt;b&gt;Evaluation (optional)&lt;/b&gt;&lt;br&gt;adk eval policypulse_rag eval/policypulse_evalset.json&lt;br&gt;runs the 13 acceptance cases against the agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#1a1a1a;fontSize=11;" vertex="1" parent="1"><mxGeometry x="740" y="840" width="460" height="100" as="geometry" /></mxCell>

        <!-- Google Cloud nodes -->
        <mxCell id="gemini" value="&lt;b&gt;Gemini 2.5 Flash&lt;/b&gt; (Vertex AI)&lt;br&gt;generateContent, region GOOGLE_CLOUD_LOCATION&lt;br&gt;Gemini 2.5 Pro: one-line env switch POLICYPULSE_MODEL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1a1a1a;fontSize=11;spacingLeft=44;" vertex="1" parent="1"><mxGeometry x="1340" y="110" width="420" height="90" as="geometry" /></mxCell>
        <mxCell id="geminiIcon" value="" style="shape=mxgraph.gcp2.cloud_machine_learning;html=1;fillColor=#9673a6;strokeColor=none;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1352" y="135" width="32" height="40" as="geometry" /></mxCell>
        <mxCell id="rag" value="&lt;b&gt;Vertex AI RAG Engine&lt;/b&gt;&lt;br&gt;RetrieveContexts, region RAG_LOCATION&lt;br&gt;corpus policypulse-5docs-corpus&lt;br&gt;5 documents&lt;br&gt;embeddings text-embedding-005&lt;br&gt;1024-token chunks, 200 overlap" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1a1a1a;fontSize=11;spacingLeft=44;" vertex="1" parent="1"><mxGeometry x="1340" y="250" width="420" height="520" as="geometry" /></mxCell>
        <mxCell id="ragIcon" value="" style="shape=mxgraph.gcp2.cloud_machine_learning;html=1;fillColor=#9673a6;strokeColor=none;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1352" y="262" width="32" height="40" as="geometry" /></mxCell>
        <mxCell id="judge" value="&lt;b&gt;Vertex AI&lt;/b&gt;&lt;br&gt;rubric-based judging of the 13 cases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#1a1a1a;fontSize=11;spacingLeft=44;" vertex="1" parent="1"><mxGeometry x="1340" y="840" width="420" height="100" as="geometry" /></mxCell>
        <mxCell id="judgeIcon" value="" style="shape=mxgraph.gcp2.cloud_machine_learning;html=1;fillColor=#9673a6;strokeColor=none;aspect=fixed;" vertex="1" parent="1"><mxGeometry x="1352" y="870" width="32" height="40" as="geometry" /></mxCell>

        <!-- Query path edges -->
        <mxCell id="e1" value="HTTP&lt;br&gt;localhost:8000" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="user" target="runner"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="streamed&lt;br&gt;answer" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="runner" target="user"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="sessions" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=none;strokeColor=#6c8ebf;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="runner" target="sessions"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="user message" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="runner" target="agent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="cited answer&lt;br&gt;or refusal" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent" target="runner"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="search_policy_documents(query)&lt;br&gt;one to several calls per question" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent" target="retr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="up to 10 chunk texts&lt;br&gt;with Cite as: labels" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.85;exitY=0;exitDx=0;exitDy=0;entryX=0.85;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="retr" target="agent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="generateContent request;&lt;br&gt;function calls and answer text return" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=block;endArrow=block;strokeColor=#d79b00;strokeWidth=3;fontSize=10;fontColor=#8a5a00;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="agent" target="gemini"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="RetrieveContexts(query);&lt;br&gt;chunks return" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=block;endArrow=block;strokeColor=#d79b00;strokeWidth=3;fontSize=10;fontColor=#8a5a00;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.1154;entryDx=0;entryDy=0;" edge="1" parent="1" source="retr" target="rag"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Ingestion path edges -->
        <mxCell id="i1" value="files" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="docs" target="extract"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="i2" value="page text" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="extract" target="split"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="i3" value="blocks" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="split" target="render"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="i4" value="rendered md" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="render" target="gate"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="i5" value="gate passed" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="gate" target="sync"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="i6" value="upload changed files;&lt;br&gt;corpus ACTIVE" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=block;endArrow=block;strokeColor=#d79b00;strokeWidth=3;fontSize=10;fontColor=#8a5a00;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.952;entryDx=0;entryDy=0;" edge="1" parent="1" source="sync" target="rag"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="i7" value="writes&lt;br&gt;corpus name" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#333333;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="sync" target="env"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="i8" value="read at startup" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=block;strokeColor=#666666;fontSize=10;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="env" target="retr"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- Evaluation edge -->
        <mxCell id="v1" value="rubric-based&lt;br&gt;judging" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=block;endArrow=block;strokeColor=#d79b00;strokeWidth=3;fontSize=10;fontColor=#8a5a00;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="eval" target="judge"><mxGeometry relative="1" as="geometry" /></mxCell>

